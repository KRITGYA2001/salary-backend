[Unit]
Description=ACME Salary Management backend
After=network.target

[Service]
User=salary
Group=salary
Environment=SPRING_DATASOURCE_URL=jdbc:sqlite:/var/lib/salary/salary.db
Environment=SERVER_ADDRESS=127.0.0.1
Environment=SERVER_PORT=8080
Environment=APP_SEED_ENABLED=true
ExecStart=/usr/bin/java -Xmx384m -Xms128m -jar /opt/salary/salary-backend.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
